{
  "name": "ai-job-search-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm run dev --prefix server\" \"wait-on http://localhost:3001/health -t 30000 && vite\"",
