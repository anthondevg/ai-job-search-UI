# Frontend (Vite) — copy to `.env` in the project root
# VITE_API_URL=http://localhost:3001

# Supabase browser credentials for authentication. Never use service_role here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Skip Gemini API calls for analyze + tailor CV; uses local dummy data instead.
VITE_DEV_MOCK_GENERATE=false
