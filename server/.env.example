GEMINI_API_KEY=your_gemini_api_key_here
# Default for new accounts: gemini-3.1-flash-lite (higher free quota)
# Fallback in code: gemini-3.5-flash
# Legacy models (2.5-flash, 2.0-flash) are NOT available to new users
GEMINI_MODEL=gemini-3.1-flash-lite
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role SECRET key — NOT the publishable/anon key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
PORT=3001
FRONTEND_URL=http://localhost:5173
